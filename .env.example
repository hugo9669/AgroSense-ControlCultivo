# =====================================================================================
#  Configuracion del servidor. En la EC2 NO hace falta copiarlo a mano:
#  scripts/setup_ec2.sh crea .env a partir de este archivo y reemplaza cada
#  "CAMBIAR_..." por una clave aleatoria. Lo UNICO que debes poner tu es GEMINI_API_KEY.
#  Evita comillas, espacios y el simbolo $ en las claves.
# =====================================================================================

# IP publica de la EC2 (informativa: la usan los scripts para imprimir URLs).
# OJO: no es IP elastica -> si detienes/inicias la instancia AWS asigna otra y hay que actualizarla
# aqui y en firmware/IoT_Orion/include/secrets.h
PUBLIC_HOST=54.145.196.10

# ---- Sensor / Agente IoT ----
# apikey que el ESP32 envia en ?k=...  Debe ser IGUAL a IOTA_APIKEY de firmware/.../secrets.h
IOTA_APIKEY=CAMBIAR_apikey
# id del dispositivo (?i=...) y nombre de la entidad en Orion
DEVICE_ID=planta01

# ---- DWH (Postgres) ----
DWH_USER=dwh
DWH_PASSWORD=CAMBIAR_dwh
DWH_DB=plantas

# ---- CrateDB (usuario "iot": UI :4200, QuantumLeap, ETL, Grafana) ----
CRATE_PASSWORD=CAMBIAR_crate

# ---- Acceso al frontend ----
FRONT_USER=admin
FRONT_PASSWORD=CAMBIAR_front
AUTH_SECRET=CAMBIAR_secreto

# ---- Grafana (usuario admin) ----
GRAFANA_ADMIN_PASSWORD=CAMBIAR_grafana

# ---- IA (Gemini) ----  Crea tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
